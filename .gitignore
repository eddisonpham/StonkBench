# --- environments -----------------------------------------------------------
.env
env
.venv
venv
ENV/

# --- python -----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- OS / editor / tooling state -------------------------------------------
.DS_Store
.vscode/
.idea/
.freebuff/
.git_backup_*/
Agent Context

# --- generated artifacts (regenerable; never commit) ------------------------
mlruns/
**/mlruns/
cache/*
testing_files/*
/gan_tests/
evaluation_plots/*
notebooks/*
docs/*
data/*
slurm_logs/
/outputs/
output*/*/**
results/*
*/**/run.jsonl
*/**/run_manifest.json
*/**/*.pt
*/**/*.pth

# Data artifacts by extension: keep generated tables out of git ...
*.csv
*.txt
*.pkl
# ... but never hide files the code or the tests actually need.
!requirements*.txt
!**/requirements*.txt
!scripts/handover/data/*
!tests/**
# ... but never the caches those directories generate.
tests/**/__pycache__/
tests/**/*.pyc

# --- handover bundle --------------------------------------------------------
# The bundle is regenerated from outputs/ by scripts/handover/; only its docs
# are source.  Everything under the four data folders is reproducible data.
/handover/MANIFEST.json
/handover/01_model_checkpoints/
/handover/02_generated_outputs/
/handover/03_ground_truth/
/handover/04_evaluation_results/

# Trained checkpoints deliberately live in the repo (weights must not live only
# in scratch).  Re-include the checkpoint trees that */**/*.pt would drop.
!checkpoints/**/*.pt
!checkpoints/**/*.pth

# Vendored model repos keep their own VCS metadata out of ours
/src/models/deep_learning/*/.git/
/src/models/deep_learning/*/.gitignore
/src/models/deep_learning/*/.gitattributes

# In-repo pip wheel cache
.cache/

# Throwaway diagnostic scripts (one-off collapse/scale checks)
scripts/dev/_diag_*.py
scripts/dev/diagnose_*.py
scripts/dev/check_scale.py
scripts/dev/compare_diagnostics.py
scripts/dev/crossseq_summary.py
scripts/dev/multiref_sanity_rerun.py
scripts/dev/repro_check_condsig.py

# Personal spec
spec.md
