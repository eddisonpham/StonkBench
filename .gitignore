.env
env
.venv
venv

# Ignore Python cache
__pycache__/
*.pyc

mlruns/
**/mlruns/

# Ignore data type files: .csv, .txt, .pkl in all directories
*.csv
*.txt
*.pkl

results/*
evaluation_plots/*

testing_files/*

cache/*

notebooks/*
*/**/*.pt
*/**/*.pth

docs/*
data/*

*/**/run.jsonl
*/**/run_manifest.json

notebooks/*
# Agent Context (gitignored planner working folder)
Agent Context
/src/models/deep_learning/*/.git/
/src/models/deep_learning/*/.gitignore
/src/models/deep_learning/*/.gitattributes

# Canonical pipeline artifacts (regenerable, kept locally under <repo>/outputs/ on each run)
/outputs/
/outputs_legacy/

# Ignore every folder of the form output*/*/** (depth >= 2 contents under any output* dir).
# Covers /outputs/, /outputs_legacy/, /outputs_legacy2/, /output_v3/, etc., at any depth in the
# tree. The leading-/less pattern matches nested output* dirs (e.g. src/output_foo/sub/x.pt)
# in addition to top-level ones. Keep this additive to /outputs/ + /outputs_legacy/ above so the
# existing canonical rules remain explicit.
output*/*/**
